# Copie este arquivo para .env e preencha.

# ---- Provedor padrão: FreeLLMAPI (custo zero, roda na sua máquina) ----
PROVIDER=freellmapi
FREELLMAPI_BASE_URL=http://localhost:3001/v1
# Chave unificada do FreeLLMAPI (formato freellmapi-...). Ela aparece no TOPO do painel
# (http://localhost:3001) depois que você cria a conta. Se o seu FreeLLMAPI não pedir chave, deixe vazio.
FREELLMAPI_KEY=
# auto | auto:fast | auto:smart | um perfil seu | um id de modelo do catálogo
FREELLMAPI_MODEL=auto:smart

# ---- Opcional: Anthropic (pago) ----
# PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Opcional: qualquer endpoint compatível com OpenAI (Ollama, OpenRouter, Groq...) ----
# PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1

# ---- Fallback: se o provedor principal falhar, tenta este (deixe vazio para desligar) ----
FALLBACK_PROVIDER=

# ---- Agente ----
# Pasta onde o agente pode ler/escrever arquivos (ele não sai dela)
WORKSPACE=./workspace
# Máximo de passos (chamadas ao modelo) por tarefa
MAX_STEPS=12

# ---- Estação (npm start) ----
PORT=8787
# Pasta dos dados (banco SQLite e checkpoints)
DATA_DIR=./data
# Quantos tripulantes podem trabalhar ao mesmo tempo
MAX_CONCURRENT=3

# ---- Terminal dos agentes (precisa do Docker Desktop rodando) ----
SHELL_IMAGE=alpine:3.20
# none = sem internet no container (recomendado) | bridge = com internet
SHELL_NETWORK=none

# ---- Novidades (tudo opcional; o painel também configura) ----
# Quanto tempo o tripulante espera sua resposta a uma pergunta (minutos)
QUESTION_WAIT_MIN=20
# Navegador dos tripulantes: 0 desliga. CHROME_PATH aponta o Chromium se não for achado sozinho.
BROWSER=1
# CHROME_PATH=/usr/bin/chromium-browser
# Ditado pelo servidor (Whisper). Pode colar na aba Canais → Voz em vez daqui.
# GROQ_API_KEY=
# Telegram/Discord: cole os tokens na aba Canais (ficam no banco da estação).

# ---- Acesso pela internet (Oracle Cloud) ----
# Endereço público com https. Deixe vazio para uso só local.
PUBLIC_URL=
# Senha para entrar na estação (obrigatória se PUBLIC_URL estiver definida; mínimo 12 caracteres)
ACCESS_PASSWORD=
